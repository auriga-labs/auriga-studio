# 認証は account.auriga.studio（共通の認証サーバー）へ移した。
# 旧 URL（/login /signup /sessions/forgot_password）をブックマーク等から開かれても
# 認証サーバーの同じページへ飛ばし、認可後はこのアプリのトップへ戻す。

RewriteEngine On

RewriteRule ^login/?$  https://account.auriga.studio/login?redirect_to=https://app.auriga.studio/  [R=302,L]
RewriteRule ^signup/?$ https://account.auriga.studio/signup?redirect_to=https://app.auriga.studio/ [R=302,L]
RewriteRule ^sessions/forgot_password/?$ https://account.auriga.studio/sessions/forgot_password [R=302,L]
